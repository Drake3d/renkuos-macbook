SubDir HAIKU_TOP src add-ons kernel drivers input apple_spi ;

SubDirC++Flags -fno-rtti ;

SubDirSysHdrs $(HAIKU_TOP) headers os drivers ;
SubDirSysHdrs $(HAIKU_TOP) src add-ons kernel drivers input hid_shared ;
UsePrivateHeaders [ FDirName kernel util ] input drivers device spi ;
UsePrivateKernelHeaders ;

SubDirHdrs [ FDirName $(HAIKU_TOP) src add-ons kernel bus_managers acpi acpica include ] ;
SubDirHdrs [ FDirName $(HAIKU_TOP) src add-ons kernel bus_managers acpi acpica include platform ] ;

SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src add-ons kernel drivers input hid_shared ] ;

